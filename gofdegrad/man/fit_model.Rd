\examples{
# 1. Six trajectories of a gamma process, inspected every time unit
set.seed(1)
x <- sim_model(0:50, "gamma", c(a = 2, b = 3), n_traj = 6)
fit_model(x, "gamma")

# 2. Several models fitted to the same data
fit_model(x, "ig")
fit_model(x, "wiener")

# 3. Irregular inspection times (common to all the trajectories)
t <- DegradSim::inspection_times("increasing", n = 30, tmax = 50)$time
x <- sim_model(t, "wiener_power", c(mu = 0.5, sigma = 0.3, r = 0.6), n_traj = 10)
fit_model(x, "wiener_power")

# 4. Gamma process with power-law shape function
x <- sim_model(0:40, "gamma_power", c(a = 1, b = 2, r = 1.5), n_traj = 10)
fit_model(x, "gamma_power")

# Wiener process with exponential trend mu (exp(lambda t) - 1)
x <- sim_model(0:50, "wiener_exp", c(mu = 0.5, sigma = 0.3, lambda = 0.05), n_traj = 30)
fit_model(x, "wiener_exp")

# 5. Inverse Gaussian process with random drift: each unit has its own
#    rate 1/delta_i, with delta_i ~ N(xi, sd_delta^2)
x <- sim_model(0:20, "ig_re", c(xi = 2, sd_delta = 0.5, eta = 3), n_traj = 30)
fit_model(x, "ig_re")
fit_model(x, "ig")   # a single rate for all the units

# 6. A matrix with one row per trajectory and the times given in t
X <- matrix(c(0.6, 1.3, 2.2, 3.1,
